# ==========================================================
# SMARTSPACE 2D/3D WORKSPACE & DATA SYSTEM - ENVIRONMENT
# Copy file nay thanh .env truoc khi chay lenh npm run dev
# ==========================================================

# 1. Server & Environment Config
NODE_ENV=development
SERVER_PORT=5000
VITE_API_BASE_URL=http://localhost:5000/api/v1

# 2. MongoDB Database Config (Ho tro ca Local va MongoDB Atlas)
MONGODB_URI=mongodb://127.0.0.1:27017/smartspace_workspace_db
ENABLE_MEMORY_FALLBACK=true

# 3. JWT & Security Config
JWT_ACCESS_SECRET=smartspace_super_secret_access_key_2026_change_me
JWT_REFRESH_SECRET=smartspace_super_secret_refresh_key_2026_change_me
JWT_EXPIRES_IN=8h
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# 4. AI Engine & Smart Recommendation Config
AI_PROVIDER_MODE=heuristic_hybrid
AI_CONFIDENCE_THRESHOLD=0.75
AI_OCCUPANCY_WEIGHT=0.6
